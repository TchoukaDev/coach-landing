---
import Container from "./ui/Container.astro";

const steps = [
  {
    number: "01",
    title: "Appel découverte",
    description: "On vérifie que le projet fait sens, on se présente.",
  },
  {
    number: "02",
    title: "Cadrage & récolte",
    description:
      "On définit ton offre, ton identité, ce que tu veux transmettre.",
  },
  {
    number: "03",
    title: "Création",
    description: "Je conçois et code ta landing page.",
  },
  {
    number: "04",
    title: "Retour & livraison",
    description: "Tu valides, j'ajuste, tu reçois ta page clé en main.",
  },
];
---

<!--
  Le wrapper donne la "hauteur de scroll" nécessaire.
  Sa hauteur est définie en JS : 100vh + distance horizontale à parcourir.
-->
<div id="process-wrapper" class="bg-bg-light-alt">
  <!--
    La section est sticky : elle reste collée en haut pendant que
    l'utilisateur scroll dans le wrapper.
  -->
  <section
    id="process-section"
    class="py-24 px-6 md:sticky md:top-0 md:h-screen md:overflow-hidden mx-auto"
  >
    <Container size="md">
      <div class="mb-16 self-start">
        <h2
          class="text-sm uppercase tracking-widest text-accent font-medium mb-4"
        >
          Mon process
        </h2>
        <p class="text-3xl md:text-4xl font-heading text-text-on-light">
          De zéro à ta page en ligne,<br />en 4 étapes.
        </p>
      </div>
    </Container>

    <ol
      id="process-track"
      class="flex gap-6 px-6 list-none will-change-transform
             flex-col
             md:flex-row md:flex-nowrap"
    >
      {
        steps.map((step) => (
          <li
            class="bg-bg-light rounded-2xl p-8 flex flex-col gap-4
                   w-full md:min-w-[clamp(280px,32vw,420px)] md:max-w-[420px] md:shrink-0"
          >
            <span class="font-heading text-5xl font-bold text-accent/20 leading-none">
              {step.number}
            </span>
            <h3 class="text-xl font-heading font-semibold text-text-on-light">
              {step.title}
            </h3>
            <p class="text-text-on-light-muted text-base leading-relaxed">
              {step.description}
            </p>
          </li>
        ))
      }
    </ol>
  </section>
</div>

<script>
  const wrapper = document.getElementById("process-wrapper");
  const track = document.getElementById("process-track");

  if (wrapper && track) {
    function update() {
      if (window.innerWidth < 768) {
        wrapper.style.height = "";
        track.style.transform = "";
        track.style.justifyContent = "";
        return;
      }

      const maxTranslate = track.scrollWidth - window.innerWidth + 48;

      // Toutes les cartes tiennent dans le viewport : centrer, pas d'animation
      if (maxTranslate <= 48) {
        wrapper.style.height = "";
        track.style.transform = "";
        track.style.justifyContent = "center";
        return;
      }

      track.style.justifyContent = "";
      wrapper.style.height = `calc(100vh + ${maxTranslate}px)`;

      const wrapperTop = wrapper.offsetTop;
      const scrollable = wrapper.offsetHeight - window.innerHeight;
      const scrolled = window.scrollY - wrapperTop;
      const progress = Math.max(0, Math.min(1, scrolled / scrollable));

      track.style.transform = `translateX(${-progress * maxTranslate}px)`;
    }

    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update, { passive: true });
    update();
  }
</script>
