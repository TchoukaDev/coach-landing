---
import Section from "../../ui/Section.astro";
import Container from "../../ui/Container.astro";

const testimonials = [
  {
    quote:
      "En quelques jours seulement, il a su cerner mes envies, comprendre la structure que je souhaitais et intégrer ce que j'aimais visuellement — sans que j'aie besoin de tout expliquer dans les détails. Le résultat est à la fois professionnel et fidèle à mon image. Rarement rencontré quelqu'un d'aussi à l'écoute et aussi efficace.",
    name: "Élodie - ELG Avenir",
    role: "Google",
    stars: 5,
  },
  {
    quote:
      "Un développeur professionnel et passionné, de bon conseil et à l'écoute de mes besoins, disponible et très réactif. Le résultat dépasse largement mes attentes.",
    name: "Clothilde Baudet - Psychologue clinicienne",
    role: "Google",
    stars: 5,
  },
];
---

<Section variant="alt">
  <Container size="md">
    <h2 class="text-sm uppercase tracking-widest text-accent font-medium mb-12">
      Ce que disent mes clients
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        testimonials.map((t) => (
          <div class="border border-text-on-light/10 rounded-2xl p-8 bg-white flex flex-col gap-6">
            <div class="flex gap-0.5">
              {Array.from({ length: t.stars }).map(() => (
                <span class="text-accent text-lg">★</span>
              ))}
            </div>
            <p class="text-text-on-light-muted text-lg leading-relaxed italic">
              "{t.quote}"
            </p>
            <div>
              <p class="font-semibold text-text-on-light">{t.name}</p>
              <p class="text-text-on-light-muted text-sm">{t.role}</p>
            </div>
          </div>
        ))
      }
    </div>
  </Container>
</Section>
