---
import Section from "../../ui/Section.astro";
import Container from "../../ui/Container.astro";

const details = [
  { label: "Format", value: "E-learning / Coaching / Mixte — à compléter" },
  { label: "Durée", value: "6 semaines / 3 mois / accès illimité — à compléter" },
  { label: "Accompagnement", value: "Sessions live, groupe, Q&A, support — à compléter" },
  { label: "Plateforme", value: "Systeme.io, Notion, Drive, Slack — à compléter" },
];
---

<Section variant="light">
  <Container size="md">
    <div class="flex flex-col gap-10">
      <div class="flex flex-col gap-4">
        <span class="text-sm font-medium tracking-widest uppercase text-accent">
          Comment ça fonctionne concrètement
        </span>
        <h2 class="font-heading font-bold text-3xl md:text-4xl text-text-on-light">
          Les modalités — à compléter
        </h2>
      </div>
      <ul class="flex flex-col gap-6">
        {details.map((d) => (
          <li class="flex flex-col sm:flex-row gap-2 sm:gap-6 border-b border-text-on-light/10 pb-6">
            <span class="font-semibold text-text-on-light w-40 shrink-0">{d.label}</span>
            <span class="text-text-on-light-muted">{d.value}</span>
          </li>
        ))}
      </ul>
    </div>
  </Container>
</Section>
