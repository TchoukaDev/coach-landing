---
import Section from "../../ui/Section.astro";
import Container from "../../ui/Container.astro";

const benefits = [
  "Un positionnement clair",
  "Une stratégie digitale adaptée",
  "Une image professionnelle",
  "Un site pensé pour convertir",
  "Un tunnel de vente opérationnel",
  "Des outils simplifiés",
  "Plus de sérénité dans ton activité",
  "Davantage d'opportunités commerciales",
  "Plus de temps pour accompagner tes clients",
];
---

<Section variant="light">
  <Container size="md">
    <h2 class="text-sm uppercase tracking-widest text-accent font-medium mb-10">
      À la fin de l'accompagnement
    </h2>
    <p class="text-2xl md:text-3xl font-heading leading-relaxed text-text-on-light-muted mb-12">
      Ce que tu obtiens<br />
      <strong class="text-text-on-light font-semibold">concrètement</strong>
    </p>
    <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {benefits.map((item) => (
        <li class="flex items-center gap-4 text-lg text-text-on-light-muted">
          <span class="text-accent shrink-0">✔</span>
          {item}
        </li>
      ))}
    </ul>
  </Container>
</Section>
