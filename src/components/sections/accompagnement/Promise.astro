---
import Section from "../../ui/Section.astro";
import Container from "../../ui/Container.astro";
---

<Section variant="dark">
  <Container size="sm">
    <div class="flex flex-col items-center text-center gap-4">
      <span class="text-sm font-medium tracking-widest uppercase text-accent mb-6">
        Moralité
      </span>
      <p class="text-2xl md:text-3xl font-heading leading-relaxed text-text-on-dark-muted">
        Tu es excellent dans ton métier.
      </p>
      <p class="text-2xl md:text-3xl font-heading leading-relaxed text-text-on-dark-muted">
        Le problème n'est pas ton expertise.
      </p>
      <p class="text-2xl md:text-3xl font-heading font-bold leading-relaxed text-text-on-dark mt-4">
        Le problème est que les bonnes personnes ne te trouvent pas.
      </p>
    </div>
  </Container>
</Section>
