---
import Section from "../../ui/Section.astro";
import Container from "../../ui/Container.astro";

const pains = [
  "N'ont pas de positionnement clair",
  "Communiquent sans stratégie",
  "Publient régulièrement sans résultat",
  "N'ont pas de site internet ou un site qui ne convertit pas",
  "Dépendent uniquement du bouche à oreille",
  "Passent plus de temps à gérer des outils qu'à accompagner leurs clients",
];
---

<Section id="douleurs">
  <Container size="md">
    <h2 class="text-sm uppercase tracking-widest text-accent font-medium mb-10">
      Tu te reconnais ?
    </h2>
    <p
      class="text-2xl md:text-3xl font-heading leading-relaxed text-text-on-light-muted mb-12"
    >
      Pourquoi tant de coachs et thérapeutes<br />
      <strong class="text-text-on-light font-semibold"
        >peinent à trouver des clients ?</strong
      >
    </p>
    <p class="text-lg text-text-on-light-muted mb-8">
      Aujourd'hui, beaucoup de professionnels de l'accompagnement :
    </p>
    <ul class="flex flex-col gap-4">
      {
        pains.map((pain) => (
          <li class="flex items-start gap-4 text-lg text-text-on-light-muted">
            <span class="text-accent font-bold mt-0.5 shrink-0">✗</span>
            {pain}
          </li>
        ))
      }
    </ul>
  </Container>
</Section>
