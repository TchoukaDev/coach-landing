---
import Section from "../../ui/Section.astro";
import Container from "../../ui/Container.astro";

const engagements = [
  "Des points d'étape réguliers",
  "Des échanges en visio",
  "Un accompagnement humain",
  "Une aide concrète lorsque tu bloques",
];
---

<Section variant="alt">
  <Container size="md">
    <h2 class="text-sm uppercase tracking-widest text-accent font-medium mb-10">
      Mon engagement
    </h2>
    <p class="text-2xl md:text-3xl font-heading leading-relaxed text-text-on-light-muted mb-12">
      Tu n'es jamais seul.<br />
      <strong class="text-text-on-light font-semibold">Je reste disponible tout au long de l'accompagnement.</strong>
    </p>
    <p class="text-lg text-text-on-light-muted mb-6">Tu bénéficies :</p>
    <ul class="flex flex-col gap-4 mb-12">
      {engagements.map((item) => (
        <li class="flex items-center gap-4 text-lg text-text-on-light-muted">
          <span class="text-accent shrink-0">✔</span>
          {item}
        </li>
      ))}
    </ul>
    <p class="text-text-on-light-muted text-lg leading-relaxed">
      Mon objectif n'est pas simplement de livrer un outil.<br />
      <strong class="text-text-on-light font-semibold">Mon objectif est que tu saches l'utiliser et que tu sois autonome.</strong>
    </p>
  </Container>
</Section>
