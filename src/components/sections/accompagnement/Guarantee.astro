---
import Section from "../../ui/Section.astro";
import Container from "../../ui/Container.astro";

const guarantees = [
  "Garantie 14 jours satisfait ou remboursé",
  "Accès à vie à la plateforme de formation",
  "Accompagnement flexible et adapté à ton rythme",
  "Aucun engagement sur le long terme",
];
---

<Section variant="alt">
  <Container size="md">
    <div class="flex flex-col gap-8">
      <div class="flex flex-col gap-4">
        <span class="text-sm font-medium tracking-widest uppercase text-accent">
          Zéro risque, 100% sérénité
        </span>
        <h2 class="font-heading font-bold text-3xl md:text-4xl text-text-on-light">
          La garantie — à compléter
        </h2>
      </div>
      <ul class="flex flex-col gap-4">
        {guarantees.map((g) => (
          <li class="flex items-start gap-3 text-text-on-light-muted text-lg">
            <span class="text-accent mt-0.5 shrink-0">✓</span>
            {g}
          </li>
        ))}
      </ul>
    </div>
  </Container>
</Section>
