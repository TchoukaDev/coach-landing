---
import Button from "../../ui/Button.astro";
import Container from "../../ui/Container.astro";
import proof1 from "../../../assets/proof1.jpeg";
import proof2 from "../../../assets/proof2.jpeg";
import proof3 from "../../../assets/proof3.jpeg";
import proof4 from "../../../assets/proof4.jpeg";
import proof5 from "../../../assets/proof5.webp";
---

<section
  class="relative overflow-hidden min-h-screen bg-bg-dark flex flex-col justify-center items-center text-center px-6 py-20"
>
  <!-- Orbes animés -->
  <div class="hero-orb hero-orb--1" aria-hidden="true"></div>
  <div class="hero-orb hero-orb--2" aria-hidden="true"></div>
  <div class="hero-orb hero-orb--3" aria-hidden="true"></div>

  <!-- Grille de fond -->
  <div class="section-grid" aria-hidden="true"></div>

  <div class="relative z-10 w-full">
    <Container>
      <p
        class="text-sm uppercase tracking-widest text-accent font-medium mb-10"
      >
        Accompagnement pour coachs de vie et thérapeutes
      </p>
      <h1>
        Transforme ta présence digitale
        <br />
        en un véritable
        <span
          class="bg-linear-to-r from-accent-hover to-accent bg-clip-text text-transparent"
          >levier de confiance</span
        >
      </h1>
      <div class="bg-accent animate-expand-x flex justify-center mx-auto w-1/2">
      </div>
      <p class="text-text-on-dark-muted md:text-xl font-heading my-8">
        J'aide les coachs et thérapeutes à attirer leurs clients idéaux grâce à
        une présence digitale claire, professionnelle et alignée avec leurs
        valeurs.
      </p>
      <div
        id="hero-cta"
        class="flex flex-col items-center justify-center md:flex-row gap-4 mt-14 md:mt-20"
      >
        <Button
          href="https://calendly.com/contact-romainwirth/offre-visibilite"
          target="_blank"
          variant="primary"
          text="Réserve ton audit stratégique gratuit"
        />
        <Button variant="secondary" text="Découvrir l'accompagnement" />
      </div>

      <!-- Preuve sociale -->
      <div class="flex items-center justify-center gap-4 mt-8">
        <div class="flex items-center">
          <img
            class="social-avatar"
            style="background: linear-gradient(135deg, #c4704a, #8b4513);"
            src={proof1.src}
            alt="Preuve de satisfaction client 1"
          />
          <img
            class="social-avatar -ml-3"
            style="background: linear-gradient(135deg, #7c6b5a, #4a3728);"
            src={proof2.src}
            alt="Preuve de satisfaction client 2"
          />
          <img
            class="social-avatar -ml-3"
            style="background: linear-gradient(135deg, #9b7d6a, #6b4c3b);"
            src={proof3.src}
            alt="Preuve de satisfaction client 3"
          />
          <img
            class="social-avatar -ml-3"
            style="background: linear-gradient(135deg, #b8603a, #7a3d20);"
            src={proof4.src}
            alt="Preuve de satisfaction client 4"
          />
          <img
            class="social-avatar -ml-3"
            style="background: linear-gradient(135deg, #d4895e, #a05a2c);"
            src={proof5.src}
            alt="Preuve de satisfaction client 5"
          />
        </div>
        <div class="text-left">
          <p class="text-text-on-dark text-sm font-semibold leading-tight">
            5+ clients accompagnés
          </p>
          <p class="text-accent text-sm font-medium leading-tight">
            100% satisfaction
          </p>
        </div>
      </div>
    </Container>
  </div>
</section>

<script>
  const scrollBtn =
    document.querySelector<HTMLButtonElement>("#hero-cta button");
  const target = document.getElementById("douleurs");
  if (scrollBtn && target) {
    scrollBtn.addEventListener("click", () => {
      target.scrollIntoView({ behavior: "smooth" });
    });
  }
</script>
