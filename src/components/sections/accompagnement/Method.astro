---
import Section from "../../ui/Section.astro";
import Container from "../../ui/Container.astro";

const steps = [
  { num: "01", title: "Étape 1 — à compléter", benefit: "Mini bénéfice de l'étape" },
  { num: "02", title: "Étape 2 — à compléter", benefit: "Mini bénéfice de l'étape" },
  { num: "03", title: "Étape 3 — à compléter", benefit: "Mini bénéfice de l'étape" },
  { num: "04", title: "Étape 4 — à compléter", benefit: "Mini bénéfice de l'étape" },
];
---

<Section variant="alt">
  <Container size="md">
    <div class="flex flex-col gap-12">
      <div class="flex flex-col gap-4">
        <span class="text-sm font-medium tracking-widest uppercase text-accent">
          Voici comment on va y arriver
        </span>
        <h2 class="font-heading font-bold text-3xl md:text-4xl text-text-on-light">
          La méthode — à compléter
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {steps.map((step) => (
          <div class="flex gap-4 items-start">
            <span class="text-3xl font-heading font-bold text-accent/30 shrink-0 leading-none">{step.num}</span>
            <div class="flex flex-col gap-1">
              <h3 class="font-heading font-semibold text-xl text-text-on-light">{step.title}</h3>
              <p class="text-text-on-light-muted">{step.benefit}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </Container>
</Section>
