---
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
---

<section
  class="relative overflow-hidden min-h-screen bg-bg-dark flex flex-col justify-center items-center text-center px-6 py-20"
>
  <Container>
    <p class="text-sm uppercase tracking-widest text-accent font-medium mb-10">
      Tu es coach de vie ou thérapeute
    </p>
    <h1>
      Ton offre mérite un <span
        class="bg-linear-to-r from-accent-hover to-accent bg-clip-text text-transparent"
        >écrin</span
      > à sa hauteur
    </h1>
    <div class="bg-accent animate-expand-x flex justify-center mx-auto w-1/2">
    </div>
    <p class="text-gray-400 md:text-xl font-heading my-8">
      Une page web qui te ressemble et convainc tes visiteurs dès le premier
      regard
    </p>
    <div
      id="hero-cta"
      class="flex flex-col items-center justify-center md:flex-row gap-4 mt-10"
    >
      <Button href="https://calendly.com/contact-romainwirth/page-pour-coachs-et-therapeutique" target="_blank" variant="primary" text="Réserve ton appel découverte" />
      <Button variant="secondary" text="Découvrir l'offre" />
    </div>
  </Container>
</section>

<script>
  const heroCta = document.getElementById("hero-cta");
  const problemsSection = document.getElementById("problems");

  if (heroCta && problemsSection) {
    heroCta.addEventListener("click", () => {
      problemsSection.scrollIntoView({ behavior: "smooth" });
    });
  }
</script>
