---
import Container from "../ui/Container.astro";

const steps = [
  {
    number: "01",
    title: "Appel découverte",
    description: "On vérifie que le projet fait sens, on se présente.",
  },
  {
    number: "02",
    title: "Cadrage & récolte",
    description: "On définit ton offre, ton identité, ce que tu veux transmettre.",
  },
  {
    number: "03",
    title: "Création",
    description: "Je conçois et code ta landing page.",
  },
  {
    number: "04",
    title: "Retour & livraison",
    description: "Tu valides, j'ajuste, tu reçois ta page clé en main.",
  },
];

const inclusions = [
  "Design sur-mesure à ton image",
  "Copywriting rédigé avec toi",
  "Modification des textes en autonomie",
  "Déploiement en ligne inclus",
  "Code source livré, tu es propriétaire",
  "Support 1 mois après livraison",
];
---

<!--
  Wrapper unique — hauteur calculée en JS.
  Deux sections sticky top-0 à l'intérieur, z-index croissant.
  Quand le wrapper se termine, les deux se décollent et les sections
  suivantes (témoignages, FAQ, CTA) arrivent naturellement.
-->
<div id="process-offer-wrapper">

  <section
    id="process-section"
    class="py-24 px-6 bg-bg-light-alt md:sticky md:top-0 md:z-10 md:h-screen md:overflow-hidden"
  >
    <Container size="md">
      <div class="mb-16">
        <h2 class="text-sm uppercase tracking-widest text-accent font-medium mb-4">
          Mon process
        </h2>
        <p class="text-3xl md:text-4xl font-heading text-text-on-light">
          De zéro à ta page en ligne,<br />en 4 étapes.
        </p>
      </div>
    </Container>

    <ol
      id="process-track"
      class="flex gap-6 px-6 list-none will-change-transform flex-col md:flex-row md:flex-nowrap"
    >
      {
        steps.map((step) => (
          <li class="bg-bg-light rounded-2xl p-8 flex flex-col gap-4 w-full md:min-w-[clamp(280px,32vw,420px)] md:max-w-[420px] md:shrink-0">
            <span class="font-heading text-5xl font-bold text-accent/20 leading-none">
              {step.number}
            </span>
            <h3 class="text-xl font-heading font-semibold text-text-on-light">
              {step.title}
            </h3>
            <p class="text-text-on-light-muted text-base leading-relaxed">
              {step.description}
            </p>
          </li>
        ))
      }
    </ol>
  </section>

  <section
    id="offer-section"
    class="bg-bg-dark flex items-center py-24 will-change-transform min-h-screen md:sticky md:top-0 md:z-20 md:h-screen"
  >
    <Container size="md" class="px-6">
      <h2 class="text-sm uppercase tracking-widest text-accent font-medium mb-16">
        L'offre
      </h2>

      <div class="flex flex-col md:flex-row items-center md:items-start md:justify-between gap-16">
        <div class="shrink-0">
          <p class="font-heading text-text-on-dark-muted text-base mb-2">Tarif unique</p>
          <p
            class="font-heading font-bold text-text-on-dark leading-none"
            style="font-size: clamp(5rem, 15vw, 9rem)"
          >
            500€
          </p>
          <p class="text-accent font-medium mt-6 text-lg">Livraison en 7 jours max</p>
        </div>

        <ul class="flex flex-col gap-5 flex-1 max-w-sm list-none">
          {inclusions.map((item) => (
            <li class="flex items-start gap-4 text-text-on-dark">
              <span class="text-accent mt-0.5 text-lg leading-none shrink-0">✓</span>
              <span class="text-base leading-snug">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </Container>
  </section>

</div>

<style>
  /* État initial de l'Offer sur desktop — hors écran en bas.
     Le JS prend le relais dès le premier scroll. */
  @media (min-width: 768px) {
    #offer-section {
      transform: translateY(100vh);
    }
  }
</style>

<script>
  const wrapper = document.getElementById("process-offer-wrapper");
  const track = document.getElementById("process-track");
  const offer = document.getElementById("offer-section");

  function update() {
    if (!wrapper || !track) return;

    const vh = window.innerHeight;

    if (window.innerWidth < 768) {
      wrapper.style.height = "";
      track.style.transform = "";
      track.style.justifyContent = "";
      if (offer) { offer.style.transform = ""; offer.style.boxShadow = ""; }
      return;
    }

    const coverPause = Math.round(vh * 0.15);
    const coverDistance = Math.round(vh * 0.6);
    // Temps de lecture de l'offre avant que le wrapper se termine
    const readTime = Math.round(vh * 0.8);

    const maxTranslate = track.scrollWidth - window.innerWidth + 48;
    const hasHScroll = maxTranslate > 48;

    if (hasHScroll) {
      track.style.justifyContent = "";
    } else {
      track.style.justifyContent = "center";
      track.style.transform = "";
    }

    const totalExtra =
      (hasHScroll ? maxTranslate : 0) + coverPause + coverDistance + readTime;
    wrapper.style.height = `calc(100vh + ${totalExtra}px)`;

    const wrapperTop = wrapper.offsetTop;
    const scrolled = window.scrollY - wrapperTop;

    if (hasHScroll) {
      const hProgress = Math.max(0, Math.min(1, scrolled / maxTranslate));
      track.style.transform = `translateX(${-hProgress * maxTranslate}px)`;
    }

    if (offer) {
      const coverStart = hasHScroll ? maxTranslate + coverPause : coverPause;
      const coverProgress = Math.max(
        0,
        Math.min(1, (scrolled - coverStart) / coverDistance),
      );
      offer.style.transform = `translateY(${(1 - coverProgress) * 100}vh)`;
      offer.style.boxShadow =
        coverProgress > 0 ? "0 -16px 40px rgba(0,0,0,0.5)" : "";
    }
  }

  window.addEventListener("scroll", update, { passive: true });
  window.addEventListener("resize", update, { passive: true });
  update();
</script>
