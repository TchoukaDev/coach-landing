---
import Container from "../../ui/Container.astro";
import Button from "../../ui/Button.astro";
import Section from "../../ui/Section.astro";
---

<Section variant="dark" className="text-center">
  <Container size="sm">
    <p class="text-sm uppercase tracking-widest text-accent font-medium mb-8">
      Prêt à te lancer ?
    </p>

    <h2
      class="font-heading font-bold text-text-on-dark leading-tight mb-8"
      style="font-size: clamp(2.5rem, 6vw, 4.5rem)"
    >
      Ta page en ligne<br />dans 7 jours.
    </h2>

    <p
      class="text-text-on-dark-muted text-lg leading-relaxed mb-12 max-w-md mx-auto"
    >
      30 minutes pour discuter de ton projet. Sans engagement.
    </p>

    <Button href="https://calendly.com/contact-romainwirth/offre-visibilite" target="_blank" variant="primary" text="Réserve ton appel découverte" />

    <p class="text-text-on-dark-muted text-sm mt-8">
      500€ · Livraison en 7 jours · 1 mois de support inclus
    </p>

    <p class="text-text-on-dark-muted/50 text-sm mt-6">
      Tu as d'autres questions ?{" "}
      <a
        href="mailto:contact@romainwirth.fr"
        class="underline underline-offset-2 hover:text-text-on-dark-muted transition-colors duration-200"
      >
        Contacte-moi par mail
      </a>
    </p>
  </Container>
</Section>
