---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-colors duration-300"
>
  <div class="mx-auto max-w-7xl px-6 py-4 flex items-center justify-between">
    <span class="font-semibold text-white text-lg">Romain Wirth</span>

    <a
      id="navbar-cta"
      href="#contact"
      class="opacity-0 pointer-events-none transition-opacity duration-300 px-6 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium rounded-xl text-sm"
    >
      Réserve un appel
    </a>
  </div>
</header>

<script>
  const navbar = document.getElementById("navbar");
  const navbarCta = document.getElementById("navbar-cta");
  const heroCta = document.getElementById("hero-cta");

  window.addEventListener(
    "scroll",
    () => {
      if (window.scrollY > 10) {
        navbar?.classList.add(
          "bg-gray-950/80",
          "backdrop-blur-md",
          "border-b",
          "border-gray-800",
        );
      } else {
        navbar?.classList.remove(
          "bg-gray-950/80",
          "backdrop-blur-md",
          "border-b",
          "border-gray-800",
        );
      }
    },
    { passive: true },
  );

  if (heroCta && navbarCta) {
    new IntersectionObserver((entries) => {
      const visible = !entries[0].isIntersecting;
      navbarCta.classList.toggle("opacity-0", !visible);
      navbarCta.classList.toggle("pointer-events-none", !visible);
    }).observe(heroCta);
  }
</script>
