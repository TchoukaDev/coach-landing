---
type Props = {
  text: string;
  variant?: "primary" | "secondary";
};

const { text, variant = "primary" } = Astro.props;

const baseStyles =
  "inline-block px-8 py-4 font-medium rounded-xl transition-colors text-center cursor-pointer";

const variants = {
  primary: "bg-blue-600 hover:bg-blue-500 text-white",
  secondary: "border border-blue-500 text-blue-500 hover:bg-blue-500/20",
};
---

<button class={`${baseStyles} ${variants[variant]}`}>
  {text}
</button>
