---
type Props = {
  text: string;
  variant?: "primary" | "secondary";
  href?: string;
  target?: string;
};

const { text, variant = "primary", href, target } = Astro.props;

const baseStyles =
  "inline-block px-8 py-4 font-medium rounded-2xl transition-colors text-center cursor-pointer text-sm md:text-base";

const variants = {
  primary: "bg-accent hover:bg-accent-hover text-text-on-dark",
  secondary: "border border-accent text-accent hover:bg-accent/20",
};
---

{
  href ? (
    <a href={href} target={target} rel={target === "_blank" ? "noopener noreferrer" : undefined} class={`${baseStyles} ${variants[variant]}`}>
      {text}
    </a>
  ) : (
    <button class={`${baseStyles} ${variants[variant]}`}>{text}</button>
  )
}
