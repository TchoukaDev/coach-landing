---
import Container from "./ui/Container.astro";

const navLinks = [
  { label: "L'offre", target: "douleurs" },
  { label: "Pourquoi moi ?", target: "a-propos" },
  { label: "Le process", target: "method-wrapper" },
  { label: "L'audit offert", target: "audit", accent: true },
  { label: "FAQ", target: "faq" },
];
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-colors duration-300 border-b border-transparent"
>
  <Container>
    <div class="mx-auto max-w-7xl px-6 py-4 flex items-center justify-between">
      <span class="font-semibold text-text-on-dark font-heading text-lg">Romain Wirth</span>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-8">
        {navLinks.map((link) => (
          <button
            class={`nav-link text-sm transition-colors duration-200 cursor-pointer ${link.accent ? "text-accent hover:text-accent-hover font-medium" : "text-text-on-dark-muted hover:text-text-on-dark"}`}
            data-target={link.target}
          >
            {link.label}
          </button>
        ))}
      </nav>

      <div class="flex items-center gap-4">
        <a
          id="navbar-cta"
          href="https://calendly.com/contact-romainwirth/offre-visibilite"
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-2 bg-accent hover:bg-accent-hover text-text-on-dark font-medium rounded-2xl text-sm"
        >
          Réserve ton audit
        </a>

        <!-- Burger mobile -->
        <button
          id="burger-btn"
          class="md:hidden flex flex-col justify-center items-center w-8 h-8 gap-1.5"
          aria-label="Menu"
          aria-expanded="false"
        >
          <span class="burger-line block w-6 h-0.5 bg-text-on-dark transition-all duration-300"></span>
          <span class="burger-line block w-6 h-0.5 bg-text-on-dark transition-all duration-300"></span>
          <span class="burger-line block w-6 h-0.5 bg-text-on-dark transition-all duration-300"></span>
        </button>
      </div>
    </div>
  </Container>
</header>

<!-- Menu mobile -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-40 bg-bg-dark flex flex-col justify-center items-center gap-8 opacity-0 pointer-events-none transition-opacity duration-300"
>
  {navLinks.map((link) => (
    <button
      class={`mobile-nav-link text-2xl font-heading font-semibold transition-colors duration-200 cursor-pointer ${link.accent ? "text-accent" : "text-text-on-dark hover:text-accent"}`}
      data-target={link.target}
    >
      {link.label}
    </button>
  ))}
  <a
    href="https://calendly.com/contact-romainwirth/offre-visibilite"
    target="_blank"
    rel="noopener noreferrer"
    class="mt-4 px-8 py-4 bg-accent hover:bg-accent-hover text-text-on-dark font-medium rounded-2xl text-base"
  >
    Réserve ton audit gratuit
  </a>
</div>

<script>
  const navbar = document.getElementById("navbar");
  const burgerBtn = document.getElementById("burger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const burgerLines = document.querySelectorAll<HTMLElement>(".burger-line");

  let menuOpen = false;

  function openMenu() {
    menuOpen = true;
    mobileMenu?.classList.remove("opacity-0", "pointer-events-none");
    burgerBtn?.setAttribute("aria-expanded", "true");
    burgerLines[0].style.transform = "translateY(8px) rotate(45deg)";
    burgerLines[1].style.opacity = "0";
    burgerLines[2].style.transform = "translateY(-8px) rotate(-45deg)";
    document.body.style.overflow = "hidden";
  }

  function closeMenu() {
    menuOpen = false;
    mobileMenu?.classList.add("opacity-0", "pointer-events-none");
    burgerBtn?.setAttribute("aria-expanded", "false");
    burgerLines[0].style.transform = "";
    burgerLines[1].style.opacity = "";
    burgerLines[2].style.transform = "";
    document.body.style.overflow = "";
  }

  burgerBtn?.addEventListener("click", () => menuOpen ? closeMenu() : openMenu());

  function scrollTo(targetId: string) {
    const target = document.getElementById(targetId);
    target?.scrollIntoView({ behavior: "smooth" });
  }

  document.querySelectorAll<HTMLButtonElement>(".nav-link, .mobile-nav-link").forEach((btn) => {
    btn.addEventListener("click", () => {
      scrollTo(btn.dataset.target ?? "");
      closeMenu();
    });
  });

  window.addEventListener("scroll", () => {
    if (window.scrollY > 10) {
      navbar?.classList.add("bg-gray-950/80", "backdrop-blur-md", "border-accent/50");
      navbar?.classList.remove("border-transparent");
    } else {
      navbar?.classList.remove("bg-gray-950/80", "backdrop-blur-md", "border-accent/50");
      navbar?.classList.add("border-transparent");
    }
  }, { passive: true });

</script>
