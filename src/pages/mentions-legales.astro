---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <main class="bg-bg-light min-h-screen px-6 py-24">
    <div class="max-w-2xl mx-auto">
      <a
        href="/"
        class="text-sm text-text-on-light-muted hover:text-text-on-light transition-colors duration-200 mb-12 inline-block"
      >
        ← Retour
      </a>

      <h1 class="font-heading text-3xl font-bold text-text-on-light mb-12">
        Mentions légales
      </h1>

      <div
        class="prose prose-neutral text-text-on-light-muted leading-relaxed space-y-8"
      >
        <section>
          <h2
            class="font-heading text-xl font-semibold text-text-on-light mb-3"
          >
            Éditeur du site
          </h2>
          <p>
            Romain Wirth — Développeur web indépendant<br />
            Adresse : Nogent, France<br />
            SIRET : 51336126100029<br />
            Email : <a href="mailto:contact@romainwirth.fr" class="underline"
              >contact@romainwirth.fr</a
            >
          </p>
        </section>

        <section>
          <h2
            class="font-heading text-xl font-semibold text-text-on-light mb-3"
          >
            Hébergement
          </h2>
          <p>
            Ce site est hébergé par Vercel Inc., 340 Pine Street Suite 701, San
            Francisco, CA 94104, États-Unis.
          </p>
        </section>

        <section>
          <h2
            class="font-heading text-xl font-semibold text-text-on-light mb-3"
          >
            Propriété intellectuelle
          </h2>
          <p>
            L'ensemble du contenu de ce site (textes, images, design) est la
            propriété de Romain Wirth. Toute reproduction sans autorisation est
            interdite.
          </p>
        </section>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
